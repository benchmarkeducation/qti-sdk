<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
    identifier="grammar-inline-choice" title="Grammar Fill-in-the-Blank" 
    adaptive="false" time-dependent="false">
    
    <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
        <qti-correct-response>
            <qti-value>choice_were</qti-value>
        </qti-correct-response>
    </qti-response-declaration>
    
    <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
        <qti-default-value>
            <qti-value>0</qti-value>
        </qti-default-value>
    </qti-outcome-declaration>
    
    <qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier">
        <qti-default-value>
            <qti-value>none</qti-value>
        </qti-default-value>
    </qti-outcome-declaration>
    
    <qti-item-body>
        <div class="question-container">
            <h3>Grammar Question</h3>
            <p>Complete the sentence by selecting the correct word from the dropdown:</p>
            
            <p class="sentence">
                The students 
                <qti-inline-choice-interaction response-identifier="RESPONSE" shuffle="false">
                    <qti-inline-choice identifier="choice_was">was</qti-inline-choice>
                    <qti-inline-choice identifier="choice_were">were</qti-inline-choice>
                    <qti-inline-choice identifier="choice_is">is</qti-inline-choice>
                    <qti-inline-choice identifier="choice_are">are</qti-inline-choice>
                </qti-inline-choice-interaction>
                excited about the field trip.
            </p>
            
            <p class="instruction">Choose the verb that agrees with the subject "students".</p>
        </div>
    </qti-item-body>
    
